# Per-workspace, never shared between organisations.
# Each folder keeps its tracked README.md so it survives a fresh clone.
#
# WARNING: `git clean -xfd` here removes exactly these three directories —
# uncommitted dev branches, plans, proofs, memory. Use explicit paths instead.

worktrees/*
!worktrees/README.md

scratchpad/*
!scratchpad/README.md

memory/*
!memory/README.md

__pycache__/
*.pyc

.DS_Store
.idea/
.vscode/
*.log
