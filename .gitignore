# Per-workspace, never shared between organisations. Ignored whole — nothing in
# them is tracked, and `python3 plugin/resolve.py --ensure` creates them where the
# workspace's .troika.json says they go, which may be outside this tree entirely.
#
# WARNING: `git clean -xfd` here removes exactly these three directories —
# uncommitted dev branches, plans, proofs, memory. Use explicit paths instead.

# Anchored with a leading slash: unanchored, `memory/` also matches
# skills/memory/, and the skill is silently never committed.
/worktrees/
/scratchpad/
/memory/

__pycache__/
*.pyc

.DS_Store
.idea/
.vscode/
*.log

# Docs build and release artefacts
site/
.venv/
*.tar.gz
*.tar.gz.sha256
.cache/
